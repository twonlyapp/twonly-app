{
  "db_name": "SQLite",
  "query": "\n            SELECT r.message_id,\n                r.emoji,\n                r.sender_id,\n                r.created_at\n            FROM reactions r\n            JOIN messages m\n            ON m.message_id = r.message_id\n            WHERE m.group_id = ?\n                AND (m.is_story = 0\n                    OR m.media_stored = 1\n            )\n            ORDER BY m.created_at DESC,\n                r.created_at DESC,\n                r.rowid DESC\n            LIMIT 1\n        ",
