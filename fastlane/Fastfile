require "tempfile"

default_platform(:android)

platform :android do
  desc "Submit a new App Bundle to the Google Play Internal Track"
  lane :internal do
    # This lane assumes that `flutter build appbundle` has already been run from the flutter root.
    upload_to_play_store(
      track: 'internal',
      aab: 'build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build the application locally and publish it to GitHub and F-Droid"
  lane :fdroid do |options|
    # Read pubspec.yaml to get the version
    pubspec_path = File.expand_path("../pubspec.yaml", __dir__)
    unless File.exist?(pubspec_path)
      UI.user_error!("Could not find pubspec.yaml at #{pubspec_path}")
    end
    
    pubspec_content = File.read(pubspec_path)
    version_match = pubspec_content.match(/^version:\s*([^+]+)/)
    unless version_match
      UI.user_error!("Could not extract version from pubspec.yaml")
    end
    
    version = version_match[1].strip
    tag_name = "v#{version}"
    UI.message("Extracted version: #{version} (tag: #{tag_name})")

    # Load release notes from CHANGELOG.md
    changelog_path = File.expand_path("../CHANGELOG.md", __dir__)
    release_notes = "Small bug fixes."
    if File.exist?(changelog_path)
      changelog_content = File.read(changelog_path)
      escaped_version = Regexp.escape(version)
      pattern = /##\s*\[?#{escaped_version}\]?(.*?)(?=##\s*|\z)/m
      match = changelog_content.match(pattern)
      if match
        release_notes = match[1].strip
        UI.message("Loaded release notes from CHANGELOG.md:\n#{release_notes}")
      else
        UI.important("Could not find release notes for version #{version} in CHANGELOG.md. Using default description.")
      end
    else
      UI.important("CHANGELOG.md not found at #{changelog_path}. Using default description.")
    end

    github_properties_path = File.expand_path("../android/key.github.properties", __dir__)
    unless File.file?(github_properties_path)
      UI.user_error!("Missing android/key.github.properties. The fdroid lane requires the GitHub release signing configuration.")
    end

    if options[:skip_build].to_s == "true"
      UI.message("Reusing existing release APKs without rebuilding...")
    else
      # Use the required GitHub release signing configuration for the build.
      key_properties_path = File.expand_path("../android/key.properties", __dir__)
      backup_properties_path = File.expand_path("../android/key.properties.backup", __dir__)

      UI.message("Found key.github.properties. Swapping in for the build...")
      if File.exist?(key_properties_path)
        FileUtils.cp(key_properties_path, backup_properties_path)
      end
      FileUtils.cp(github_properties_path, key_properties_path)

      begin
        # Build the Android application
        UI.message("Building Android APK...")
        Dir.chdir(File.expand_path("..", __dir__)) do
          sh("flutter build apk --release --split-per-abi")
        end
      ensure
        UI.message("Restoring original key.properties...")
        if File.exist?(backup_properties_path)
          FileUtils.cp(backup_properties_path, key_properties_path)
          FileUtils.rm(backup_properties_path)
        else
          FileUtils.rm_f(key_properties_path)
        end
      end
    end

    # Find built APKs
    apk_glob = File.expand_path("../build/app/outputs/flutter-apk/*-release.apk", __dir__)
    apks = Dir.glob(apk_glob)
    
    if apks.empty?
      UI.user_error!("No release APKs found matching #{apk_glob}")
    end
    
    UI.message("Found APKs to upload: #{apks.join(', ')}")

    # Verify every APK before creating a release or publishing any assets.
    local_properties_path = File.expand_path("../android/local.properties", __dir__)
    local_sdk = File.file?(local_properties_path) ? File.read(local_properties_path)[/^sdk\.dir=(.+)$/, 1]&.strip : nil
    sdk_roots = [local_sdk, ENV["ANDROID_HOME"], ENV["ANDROID_SDK_ROOT"]].compact.reject(&:empty?)
    apksigner_candidates = sdk_roots.flat_map do |sdk_root|
      Dir.glob(File.join(sdk_root, "build-tools", "*", "apksigner"))
         .sort_by { |path| File.basename(File.dirname(path)).split(".").map(&:to_i) }.reverse
    end
    apksigner_candidates.concat(ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).map { |dir| File.join(dir, "apksigner") })
    apksigner = apksigner_candidates.find { |path| File.file?(path) && File.executable?(path) }
    unless apksigner
      UI.user_error!("Could not find apksigner. Install Android SDK build-tools and configure android/local.properties, ANDROID_HOME, or ANDROID_SDK_ROOT.")
    end

    expected_certificate = "e3c44d568c67f932ac8c3390998ab95ee8ff2d7a073c24e3667793e6eacd770a"
    apks.each do |apk_path|
      verification = sh(apksigner, "verify", "--print-certs", apk_path, log: false) do |status, output, _command|
        unless status.success?
          UI.user_error!("APK signature verification failed for #{File.basename(apk_path)}: #{output}")
        end
        output
      end
      certificates = verification.scan(/^Signer #\d+ certificate SHA-256 digest: ([0-9a-fA-F:]+)\s*$/)
                                 .flatten.map { |digest| digest.delete(":").downcase }
      unless certificates == [expected_certificate]
        UI.user_error!("Unexpected signing certificate for #{File.basename(apk_path)}. Expected SHA-256 #{expected_certificate}; found #{certificates.inspect}.")
      end
    end

    # gh streams large APK uploads without Fastlane's Excon write timeout.
    # It uses GITHUB_TOKEN/GH_TOKEN or the existing gh login without logging a token.
    repository = "twonlyapp/twonly-app"
    release_exists = sh("gh", "release", "view", tag_name, "--repo", repository, log: false) do |status, output, _command|
      if status.success?
        true
      elsif output.match?(/release not found|HTTP 404/i)
        false
      else
        UI.user_error!("Could not check GitHub release #{tag_name}: #{output}")
      end
    end

    if release_exists
      UI.message("Resuming uploads to GitHub release #{tag_name}...")
    else
      UI.message("Creating GitHub release #{tag_name}...")
      Tempfile.create(["twonly-release-notes", ".md"]) do |notes|
        notes.write(release_notes)
        notes.flush
        sh("gh", "release", "create", tag_name, "--repo", repository,
           "--title", "Release #{tag_name}", "--notes-file", notes.path)
      end
    end

    apks.each do |apk_path|
      attempts = 0
      begin
        attempts += 1
        # Replaces partial assets left by an interrupted upload of this version.
        sh("gh", "release", "upload", tag_name, apk_path, "--repo", repository, "--clobber")
      rescue StandardError
        raise if attempts >= 3

        UI.important("Upload of #{File.basename(apk_path)} failed; retrying (#{attempts + 1}/3)...")
        sleep(5 * attempts)
        retry
      end
    end
    UI.success("Successfully uploaded release #{tag_name} to GitHub!")

    # F-Droid deployment
    fdroid_repo_dir = "/Users/tobi/Documents/drive/twonly/F-Droid/repo"
    UI.message("Starting F-Droid deployment...")
    FileUtils.mkdir_p(fdroid_repo_dir)

    # Delete all APK files in the directory
    sh("rm -f #{fdroid_repo_dir}/*.apk")
    
    UI.message("All APK files deleted.")

    apks.each do |apk_path|
      basename = File.basename(apk_path)
      new_name = "eu.twonly_v#{version}-#{basename}"
      dest_path = File.join(fdroid_repo_dir, new_name)
      UI.message("Copying APK to F-Droid repo: #{dest_path}")
      FileUtils.cp(apk_path, dest_path)
    end

    fdroid_dir = "/Users/tobi/Documents/drive/twonly/F-Droid"
    update_script = File.join(fdroid_dir, "update.sh")
    if File.exist?(update_script)
      UI.message("Executing F-Droid update script...")
      Dir.chdir(fdroid_dir) do
        sh("chmod +x ./update.sh && ./update.sh")
      end
    else
      UI.important("F-Droid update script not found at #{update_script}")
    end
  end
end
