require "shellwords"
require "tempfile"
require "tmpdir"
require "fileutils"

def release_notes_for(project_root)
  pubspec_path = File.join(project_root, "pubspec.yaml")
  UI.user_error!("Could not find pubspec.yaml at #{pubspec_path}") unless File.file?(pubspec_path)
  version_match = File.read(pubspec_path).match(/^version:[ \t]*([^+\r\n]+)/)
  UI.user_error!("Could not extract version from pubspec.yaml") unless version_match
  version = version_match[1].strip

  changelog_path = File.join(project_root, "CHANGELOG.md")
  if File.file?(changelog_path)
    escaped_version = Regexp.escape(version)
    pattern = /^##[ \t]+(?:#{escaped_version}|\[#{escaped_version}\])(?:[ \t]+[^\r\n]*)?\r?\n(.*?)(?=^##[ \t]+|\z)/m
    match = File.read(changelog_path).match(pattern)
    notes = match && match[1].strip
  end

  if notes.nil? || notes.empty?
    UI.important("No release notes found for #{version} in CHANGELOG.md. Using default description.")
    notes = "Small bug fixes."
  end
  [version, notes]
end

default_platform(:android)

platform :ios do
  desc "Build a release IPA and upload it to TestFlight (skip_build:true re-exports the existing archive)"
  lane :beta do |options|
    upload_options = {
      app_identifier: 'eu.twonly',
      apple_id: '6743774441',
      skip_waiting_for_build_processing: true
    }
    api_key_configured = %w[PILOT_API_KEY_PATH APP_STORE_CONNECT_API_KEY_PATH PILOT_API_KEY APP_STORE_CONNECT_API_KEY].any? do |name|
      !ENV[name].to_s.strip.empty?
    end
    unless api_key_configured
      # With apple_id set, Pilot skips login. Transporter's later username prompt
      # does not update Pilot's username, so altool can receive no credentials.
      username = (options[:username] || ENV['PILOT_USERNAME'] || ENV['FASTLANE_USER']).to_s.strip
      username = UI.input("Apple Developer account email:").to_s.strip if username.empty?
      UI.user_error!("An upload username is required. Set PILOT_USERNAME or pass username:your-email.") if username.empty?
      upload_options[:username] = username
      upload_options[:provider_public_id] = options[:provider_public_id] if options[:provider_public_id]
    end

    project_root = File.expand_path("..", __dir__)
    archive_path = File.join(project_root, "build/ios/archive/Runner.xcarchive")
    ipa_dir = File.join(project_root, "build/ios/ipa")
    ipa_glob = File.join(ipa_dir, "*.ipa")
    skip_build = options[:skip_build].to_s == "true"
    if skip_build && !File.directory?(archive_path)
      UI.user_error!("No existing archive at #{archive_path}. Run fastlane ios beta without skip_build:true first.")
    end
    # Flutter may finish archiving without producing an IPA if export fails.
    # Remove previous exports so that only this build can be uploaded.
    FileUtils.rm_f(Dir.glob(ipa_glob))
    Tempfile.create(["twonly-export-options", ".plist"]) do |export_options|
      # Request automatic distribution signing for the app and every extension.
      # Leave certificates and profiles to Xcode, including cloud-managed signing.
      export_options.write(<<~PLIST)
        <?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
        <plist version="1.0"><dict>
          <key>method</key><string>app-store-connect</string>
          <key>destination</key><string>export</string>
          <key>signingStyle</key><string>automatic</string>
          <key>teamID</key><string>CN332ZUGRP</string>
          <key>manageAppVersionAndBuildNumber</key><false/>
        </dict></plist>
      PLIST
      export_options.flush

      Dir.chdir(project_root) do
        if skip_build
          sh("xcodebuild", "-exportArchive", "-archivePath", archive_path,
             "-exportPath", ipa_dir, "-exportOptionsPlist", export_options.path,
             "-allowProvisioningUpdates")
        else
          sh("flutter", "build", "ipa", "--release", "--export-options-plist", export_options.path)
        end
      end
    end

    ipas = Dir.glob(ipa_glob)
    unless ipas.length == 1
      UI.user_error!("Expected one freshly exported IPA in build/ios/ipa; found #{ipas.length}. Check the Flutter export and Xcode signing configuration.")
    end

    # App-specific passwords stay in Fastlane's Keychain or its password env var.
    upload_to_testflight(**upload_options.merge(ipa: ipas.first))
  end
end

platform :android do
  desc "Build a release App Bundle and submit it to the Google Play Internal Track"
  lane :internal do
    project_root = File.expand_path("..", __dir__)
    _version, release_notes = release_notes_for(project_root)
    Dir.chdir(project_root) do
      sh("flutter build appbundle --release")
    end

    # Supply uploads changelogs separately from store metadata. Isolate English
    # notes from the repository's other metadata and clean up even on failure.
    Dir.mktmpdir("twonly-play-notes") do |metadata_path|
      changelog_dir = File.join(metadata_path, "en-US", "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(File.join(changelog_dir, "default.txt"), release_notes)
      upload_to_play_store(
        track: 'internal',
        aab: File.join(project_root, 'build/app/outputs/bundle/release/app-release.aab'),
        metadata_path: metadata_path,
        skip_upload_changelogs: false,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

  desc "Promote the existing internal release to closed, open, and production by default; use track: to select one destination"
  lane :promote do |options|
    target = options[:track].to_s.strip
    if target == 'internal'
      UI.user_error!("The source track is internal. Choose track:all, track:closed, track:open, track:production, or a custom closed testing track name.")
    end
    targets = target.empty? || target == 'all' ? %w[closed open production] : [target]
    targets.each do |destination|
      destination = { 'closed' => 'twonly-closed-tests', 'open' => 'beta' }.fetch(destination, destination)

      UI.message("Promoting the existing internal release to #{destination}...")
      upload_to_play_store(
        track: 'internal',
        track_promote_to: destination,
        track_promote_release_status: 'completed',
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        # Preserve the uploaded release notes when promoting the same bundle.
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    end
  end

  desc "Build the application locally and publish it to GitHub and F-Droid"
  lane :fdroid do |options|
    project_root = File.expand_path("..", __dir__)
    version, release_notes = release_notes_for(project_root)
    tag_name = "v#{version}"
    UI.message("Extracted version: #{version} (tag: #{tag_name})")

    github_properties_path = File.expand_path("../android/key.github.properties", __dir__)
    unless File.file?(github_properties_path)
      UI.user_error!("Missing android/key.github.properties. The fdroid lane requires the GitHub release signing configuration.")
    end

    if options[:skip_build].to_s == "true"
      UI.message("Reusing existing release APKs without rebuilding...")
    else
      # Use the required GitHub release signing configuration for the build.
      key_properties_path = File.expand_path("../android/key.properties", __dir__)
      backup_properties_path = File.expand_path("../android/key.properties.backup", __dir__)

      UI.message("Found key.github.properties. Swapping in for the build...")
      if File.exist?(key_properties_path)
        FileUtils.cp(key_properties_path, backup_properties_path)
      end
      FileUtils.cp(github_properties_path, key_properties_path)

      begin
        # Build the Android application
        UI.message("Building Android APK...")
        Dir.chdir(File.expand_path("..", __dir__)) do
          sh("flutter build apk --release --split-per-abi")
        end
      ensure
        UI.message("Restoring original key.properties...")
        if File.exist?(backup_properties_path)
          FileUtils.cp(backup_properties_path, key_properties_path)
          FileUtils.rm(backup_properties_path)
        else
          FileUtils.rm_f(key_properties_path)
        end
      end
    end

    # Find built APKs
    apk_glob = File.expand_path("../build/app/outputs/flutter-apk/*-release.apk", __dir__)
    apks = Dir.glob(apk_glob)
    
    if apks.empty?
      UI.user_error!("No release APKs found matching #{apk_glob}")
    end
    
    UI.message("Found APKs to upload: #{apks.join(', ')}")

    # Verify every APK before creating a release or publishing any assets.
    local_properties_path = File.expand_path("../android/local.properties", __dir__)
    local_sdk = File.file?(local_properties_path) ? File.read(local_properties_path)[/^sdk\.dir=(.+)$/, 1]&.strip : nil
    sdk_roots = [local_sdk, ENV["ANDROID_HOME"], ENV["ANDROID_SDK_ROOT"]].compact.reject(&:empty?)
    apksigner_candidates = sdk_roots.flat_map do |sdk_root|
      Dir.glob(File.join(sdk_root, "build-tools", "*", "apksigner"))
         .sort_by { |path| File.basename(File.dirname(path)).split(".").map(&:to_i) }.reverse
    end
    apksigner_candidates.concat(ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).map { |dir| File.join(dir, "apksigner") })
    apksigner = apksigner_candidates.find { |path| File.file?(path) && File.executable?(path) }
    unless apksigner
      UI.user_error!("Could not find apksigner. Install Android SDK build-tools and configure android/local.properties, ANDROID_HOME, or ANDROID_SDK_ROOT.")
    end

    expected_certificate = "e3c44d568c67f932ac8c3390998ab95ee8ff2d7a073c24e3667793e6eacd770a"
    apks.each do |apk_path|
      verification = sh(apksigner, "verify", "--print-certs", apk_path, log: false) do |status, output, _command|
        unless status.success?
          UI.user_error!("APK signature verification failed for #{File.basename(apk_path)}: #{output}")
        end
        output
      end
      certificates = verification.scan(/^Signer #\d+ certificate SHA-256 digest: ([0-9a-fA-F:]+)\s*$/)
                                 .flatten.map { |digest| digest.delete(":").downcase }
      unless certificates == [expected_certificate]
        UI.user_error!("Unexpected signing certificate for #{File.basename(apk_path)}. Expected SHA-256 #{expected_certificate}; found #{certificates.inspect}.")
      end
    end

    # gh streams large APK uploads without Fastlane's Excon write timeout.
    # It uses GITHUB_TOKEN/GH_TOKEN or the existing gh login without logging a token.
    repository = "twonlyapp/twonly-app"
    release_exists = sh("gh", "release", "view", tag_name, "--repo", repository, log: false) do |status, output, _command|
      if status.success?
        true
      elsif output.match?(/release not found|HTTP 404/i)
        false
      else
        UI.user_error!("Could not check GitHub release #{tag_name}: #{output}")
      end
    end

    if release_exists
      UI.message("Resuming uploads to GitHub release #{tag_name}...")
    else
      UI.message("Creating GitHub release #{tag_name}...")
      Tempfile.create(["twonly-release-notes", ".md"]) do |notes|
        notes.write(release_notes)
        notes.flush
        sh("gh", "release", "create", tag_name, "--repo", repository,
           "--title", "Release #{tag_name}", "--notes-file", notes.path)
      end
    end

    apks.each do |apk_path|
      attempts = 0
      begin
        attempts += 1
        # Replaces partial assets left by an interrupted upload of this version.
        sh("gh", "release", "upload", tag_name, apk_path, "--repo", repository, "--clobber")
      rescue StandardError
        raise if attempts >= 3

        UI.important("Upload of #{File.basename(apk_path)} failed; retrying (#{attempts + 1}/3)...")
        sleep(5 * attempts)
        retry
      end
    end
    UI.success("Successfully uploaded release #{tag_name} to GitHub!")

    # F-Droid deployment
    fdroid_repo_dir = "/Users/tobi/Documents/drive/twonly/F-Droid/repo"
    UI.message("Starting F-Droid deployment...")
    FileUtils.mkdir_p(fdroid_repo_dir)

    # Delete all APK files in the directory
    sh("rm -f #{fdroid_repo_dir}/*.apk")
    
    UI.message("All APK files deleted.")

    apks.each do |apk_path|
      basename = File.basename(apk_path)
      new_name = "eu.twonly_v#{version}-#{basename}"
      dest_path = File.join(fdroid_repo_dir, new_name)
      UI.message("Copying APK to F-Droid repo: #{dest_path}")
      FileUtils.cp(apk_path, dest_path)
    end

    fdroid_dir = "/Users/tobi/Documents/drive/twonly/F-Droid"
    update_script = File.join(fdroid_dir, "update.sh")
    if File.exist?(update_script)
      UI.message("Executing F-Droid update script...")
      Dir.chdir(fdroid_dir) do
        sh("chmod +x ./update.sh && TWONLY_APP_DIR=#{Shellwords.escape(project_root)} ./update.sh")
      end
    else
      UI.important("F-Droid update script not found at #{update_script}")
    end
  end
end
